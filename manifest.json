
{
  "manifest_version": 3,
  "name": "AI Image Guard",
  "version": "1.1.0",
  "description": "Helps identify AI-generated images with simple, elder-friendly alerts.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
